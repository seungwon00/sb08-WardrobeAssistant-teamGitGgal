# GHCR 이미지 (docker-compose.prod.yaml의 app 서비스). OWNER/REPO는 반드시 소문자 (GHCR 규칙)
# 이 저장소 기준: ghcr.io/seungwon00/sb08-wardrobeassistant-teamgitggal:latest
APP_IMAGE=ghcr.io/seungwon00/sb08-wardrobeassistant-teamgitggal:latest

# 도메인 (없으면 EC2 탄력적 IP 기반 sslip.io, 예: 1-2-3-4.sslip.io)
DOMAIN=example.sslip.io

# Postgres
POSTGRES_PORT=5432
POSTGRES_DB=clothesplz
POSTGRES_USER=clothesplz
POSTGRES_PASSWORD=
POSTGRES_URL=postgres

# Redis (단일 EC2 내부 컨테이너 간 통신이라 TLS 불필요)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SSL_ENABLED=false

# AWS (S3 + CloudFront 용 IAM 사용자)
AWS_PROJECT_NAME=clothesplz
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# ADMIN
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server
PORT=8080

# weather API
WEATHER_API_URL=
WEATHER_API_SERVICE_KEY=

# Kakao API
KAKAO_REST_API_KEY=

# JWT
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXP=900000
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXP=3600000

# Naver Mail
NAVER_ID=
NAVER_APP_PW=

# AI (의상 추천에 사용)
OPENAI_API_KEY=

# Open Search
OPENSEARCH_PORT=9200
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Kafka (브로커 1대라 복제 수 1로 설정)
KAFKA_BOOTSTRAP_SERVERS=broker:29092
KAFKA_PORT=9092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1

# Oauth
KAKAO_OAUTH_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://example.sslip.io
